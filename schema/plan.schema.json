{
  "$id": "plan",
  "title": "Lesson plan: jobs/outbox/<job>/<lessonId>.plan.json",
  "type": "object",
  "required": [
    "competences",
    "objectives",
    "methods",
    "materials",
    "references",
    "steps",
    "assessment"
  ],
  "properties": {
    "competences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "languageCompetence": {
      "type": "string",
      "maxLength": 500
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "priorKnowledge": {
      "type": "string",
      "maxLength": 1000
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "description": "Method NAMES only, e.g. Discussion, Demonstration, Question and answer"
    },
    "materials": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "description": "Titles of the pack sources used"
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "stage",
          "minutes",
          "teacherActivity",
          "learnerActivity"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "maxLength": 80
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          },
          "content": {
            "type": "string",
            "maxLength": 3000,
            "description": "The exact points taught or written on the board in this step, from the notes (required for development and practice steps)"
          },
          "teacherActivity": {
            "type": "string",
            "maxLength": 2000
          },
          "learnerActivity": {
            "type": "string",
            "maxLength": 2000
          },
          "source": {
            "$ref": "cite",
            "description": "Required when the step uses a classroom activity, story, song or demonstration from a source"
          }
        },
        "additionalProperties": false
      }
    },
    "assessment": {
      "type": "string",
      "maxLength": 2000
    },
    "homework": {
      "type": "string",
      "maxLength": 1000
    },
    "lifeSkills": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    }
  },
  "additionalProperties": false
}
